# Roblox Studio lock / backup / autosave files
*.rbxl.lock
*.rbxl.bak
*.rbxl.autosave
*.rbxlx.lock
*.rbxlx.bak

# Python / Node
.venv/
__pycache__/
*.pyc
node_modules/

# Large captures and videos (kept on disk only)
captures/
*.mp4

# Secrets
.env
.env.*
*.pem
*.key

# Third-party reference images (not ours; kept on disk only, public repo)
art/gen/ref_*.jpg
# Raw Blender renders (the bloomed *_fx.jpg, sheets, GLBs and manifests are kept)
blender/out/**/*_front.png
blender/out/**/*_side.png
blender/out/**/*_hero.png
blender/out/**/*_three_quarter.png
blender/out/**/*_game_side.png
# Studio lock files
*.lock
art/gen/_compare*.jpg

